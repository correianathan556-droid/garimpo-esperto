  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 2px;
}
.hero h1 {
  font-size: clamp(30px, 5vw, 48px);
  margin: 14px auto;
  max-width: 760px;
  line-height: 1.12;
}
.hero h1 span { color: var(--amarelo); }
.hero p {

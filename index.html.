<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Garimpo Esperto | Achadinhos que valem a pena</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#111;color:#fff;font-family:Arial,sans-serif}
header{padding:24px 5%;background:#080808;border-bottom:4px solid #ffd21a}
.logo{font-size:26px;font-weight:900}
.logo span{color:#ffd21a}
.hero{padding:45px 5%;background:#ffd21a;color:#111}
.hero h1{font-size:38px;margin:0 0 12px}
.hero p{font-size:17px}
main{max-width:1100px;margin:auto;padding:25px 5%}
input,select{padding:12px;border-radius:8px;border:1px solid #ccc;margin:5px 5px 20px 0}
input{width:60%;max-width:400px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.card{background:#222;border:1px solid #444;border-radius:12px;padding:18px}
.icon{font-size:45px}
.card h3{margin-bottom:8px}
.card p{color:#ccc}
.btn{display:block;text-align:center;background:#ffd21a;color:#111;font-weight:bold;text-decoration:none;padding:12px;border-radius:8px}
footer{padding:25px 5%;text-align:center;background:#080808;color:#ccc}
@media(max-width:500px){.hero h1{font-size:30px}input{width:100%}}
</style>
</head>
<body>
<header>
  <div class="logo">GARIMPO <span>ESPERTO</span></div>
  <div>Achadinhos que valem a pena</div>
</header>
<section class="hero">
  <h1>Achadinhos incríveis, preços espertos!</h1>
  <p>Encontre produtos úteis para sua casa e seu dia a dia.</p>
</section>
<main>
  <h2>Nossos achadinhos</h2>
  <input id="busca" placeholder="Buscar produto..." oninput="filtrar()">
  <select id="categoria" onchange="filtrar()">
    <option value="">Todas as categorias</option>
    <option value="Tecnologia">Tecnologia</option>
    <option value="Celular">Acessórios para celular</option>
    <option value="Casa">Casa e cozinha</option>
  </select>
  <div class="grid" id="produtos">
    <article class="card" data-cat="Tecnologia">
      <div class="icon">🔌</div><h3>Carregador 40W</h3>
      <p>Carregador com cabo para o dia a dia.</p>
      <a class="btn" href="https://meli.la/1cVayYi" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Tecnologia">
      <div class="icon">⚡</div><h3>Carregador 67W</h3>
      <p>Confira a compatibilidade com seu aparelho.</p>
      <a class="btn" href="https://meli.la/1rNfrX1" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Celular">
      <div class="icon">💡</div><h3>Ring light com tripé</h3>
      <p>Iluminação para vídeos e fotos.</p>
      <a class="btn" href="https://meli.la/1YRfJec" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Tecnologia">
      <div class="icon">🎧</div><h3>Fone sem fio</h3>
      <p>Fone Bluetooth para ouvir suas músicas.</p>
      <a class="btn" href="https://meli.la/1BVyQm6" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Celular">
      <div class="icon">🤳</div><h3>Tripé e bastão de selfie</h3>
      <p>Para fotos, vídeos e chamadas.</p>
      <a class="btn" href="https://meli.la/1yEftdc" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Celular">
      <div class="icon">📱</div><h3>Capinha magnética</h3>
      <p>Confira o modelo compatível no anúncio.</p>
      <a class="btn" href="https://meli.la/1oZ1AdK" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Celular">
      <div class="icon">💧</div><h3>Capa impermeável</h3>
      <p>Confira as instruções de uso no anúncio.</p>
      <a class="btn" href="https://meli.la/27DGHVg" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Casa">
      <div class="icon">🛏️</div><h3>Jogo de cama</h3>
      <p>Renove o visual do seu quarto.</p>
      <a class="btn" href="https://meli.la/1HDyCgr" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Casa">
      <div class="icon">🧣</div><h3>Cobertor</h3>
      <p>Confira medidas e material no anúncio.</p>
      <a class="btn" href="https://meli.la/14rGzsF" target="_blank" rel="noopener">Ver oferta</a>
    </article>
    <article class="card" data-cat="Casa">
      <div class="icon">🧂</div><h3>Porta-temperos</h3>
      <p>Organize os temperos na cozinha.</p>
      <a class="btn" href="https://meli.la/1qzyyvt" target="_blank" rel="noopener">Ver oferta</a>
    </article>
  </div>
  <p id="vazio" style="display:none">Nenhum produto encontrado.</p>
  <p style="color:#bbb;font-size:13px;margin-top:25px">Alguns links podem gerar comissão para esta loja, sem custo adicional para você. Confira preço e disponibilidade no Mercado Livre.</p>
</main>
<footer>© <span id="ano"></span> Garimpo Esperto · Achadinhos que valem a pena</footer>
<script>
function filtrar(){
 const q=document.getElementById('busca').value.toLowerCase();
 const cat=document.getElementById('categoria').value;
 let total=0;
 document.querySelectorAll('.card').forEach(c=>{
  const ok=c.innerText.toLowerCase().includes(q)&&(!cat||c.dataset.cat===cat);
  c.style.display=ok?'block':'none';
  if(ok)total++;
 });
 document.getElementById('vazio').style.display=total?'none':'block';
}
document.getElementById('ano').textContent=new Date().getFullYear();
</script>
</body>
</html>

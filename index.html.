main { max-width: 1120px; margin: auto; padding: 35px 20px 55px; }
.intro { text-align: center; margin-bottom: 28px; }
.intro h2 { font-size: 29px; margin-bottom: 8px; }
.intro p { color: #666; line-height: 1.6; }
.categorias {

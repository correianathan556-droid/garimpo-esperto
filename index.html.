  .figura { min-height: 105px; font-size: 48px; }
  .conteudo { padding: 12px; }
  .produto h3 { font-size: 15px; }
  .produto p { font-size: 12px; }
  .comprar { font-size: 12px; padding: 12px 5px; }
  .whatsapp { right: 10px; bottom: 12px; font-size: 13px; padding: 12px 14px; }
}
</style>
</head>

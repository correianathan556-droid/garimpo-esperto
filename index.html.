  background: white;
  color: #222;
  border: 1px solid #e5e5e5;
  border-radius: 25px;
  padding: 10px 15px;
  font-size: 13px;
  text-decoration: none;
}
.categorias a:hover { background: var(--amarelo); }
.produtos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}
.produto {
  background: white;
  border: 1px solid #e9e9e9;
  border-radius: 15px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 5px 18px #00000009;
  transition: transform .2s, box-shadow .2s;
}
.produto:hover {
  transform: translateY(-4px);
  box-shadow: 0 9px 25px #00000012;
}
.figura {
  min-height: 145px;
  background: #fff8d9;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 65px;
}
.conteudo {
  padding: 18px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.etiqueta {
  color: #7b6500;
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase; 
  letter-spacing: 1px;
}
.produto h3 { font-size: 18px; margin: 10px 0; }
.produto p {
  color: #666;
  font-size: 14px;
  line-height: 1.55;
  flex: 1;
}
.comprar {
  display: block;
  background: var(--preto);
  color: white;
  text-align: center;
  padding: 13px 10px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
  margin-top: 12px;
}
.comprar:hover { background: #383838; color: var(--amarelo); }
.aviso {
  background: white;
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 20px;
  margin-top: 32px;
  font-size: 13px;
  line-height: 1.7;
  color: #555;

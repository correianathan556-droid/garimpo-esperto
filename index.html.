}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: #f5f5f5;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
}
header {
  background: var(--preto);
  color: var(--branco);
  padding: 20px;
